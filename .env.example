# cherubgyre — example environment file.
#
# Copy to .env before running the server:
#     cp .env.example .env
# Then replace the CHANGE_ME values with real secrets. Never commit .env.
#
# Generate each secret with:
#     openssl rand -hex 32

# ---- required ----

# JWT signing key. Must be at least 32 bytes. The server fails to
# start if this is unset or shorter than 32 bytes.
JWT_SECRET=CHANGE_ME_TO_A_32_BYTE_SECRET_AT_LEAST

# Shared secret required on /admin/* endpoints via the
# X-Admin-Token request header. Must be at least 16 bytes.
ADMIN_TOKEN=CHANGE_ME_TO_A_RANDOM_ADMIN_TOKEN

# ---- optional (defaults shown) ----

# HTTP listen port.
# PORT=8080

# Max /login attempts per client IP within the sliding window.
# LOGIN_RATE_LIMIT=10

# Sliding window length for LOGIN_RATE_LIMIT, in seconds.
# LOGIN_RATE_WINDOW_SECONDS=300

# Set to "false" to disable the daily background job that
# deregisters users who have been inactive for more than a year.
# Recommended when running multiple replicas; leave enabled on
# exactly one process.
# RUN_INACTIVITY_JOB=true

# Log level: debug | info | warn | error.
# LOG_LEVEL=info

# Overrides the built-in bootstrap invite code. Set to a fresh UUID
# (or any other unguessable value) to rotate the bootstrap credential
# without recompiling. Leave unset to keep the default used by
# existing test fixtures and quickstart docs.
# MASTER_INVITE_CODE=
