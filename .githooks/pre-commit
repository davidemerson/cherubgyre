#!/bin/sh
# Pre-commit hook: verify the project still builds, vets clean, and tests pass.
# Intentionally does NOT write any artifacts into the tree.

set -e

echo "Running go vet..."
go vet ./...

echo "Running go build (no output)..."
go build -o /dev/null ./...

echo "Running go test..."
go test ./... -count=1

echo "OK"
